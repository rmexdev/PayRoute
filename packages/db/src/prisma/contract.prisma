// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model Account {
  accountId     Int           @id(map: "accounts_pkey") @default(autoincrement()) @map("account_id")
  accountCode   Int           @unique(map: "accounts_account_code_key") @map("account_code")
  accountName   String        @map("account_name")
  accountType   String        @map("account_type")
  normalBalance String        @map("normal_balance")
  ledgerEntries LedgerEntry[]

  @@check(expression: sql`(account_type = ANY (ARRAY['asset'::text, 'liability'::text, 'equity'::text, 'revenue'::text, 'expense'::text]))`, map: "accounts_account_type_check")
  @@check(expression: sql`(normal_balance = ANY (ARRAY['debit'::text, 'credit'::text]))`, map: "accounts_normal_balance_check")
  @@map("account")
}

model Transcation {
  transactionId Int                                        @id(map: "ledger_entry_pkey") @default(autoincrement()) @map("transaction_id")
  entryDate     Date                                       @map("entry_date")
  description   String
  createdAt     DateTime(storage: timestamp, precision: 6) @default(now()) @map("created_at")
  ledgerEntries LedgerEntry[]

  @@map("transcation")
}

model LedgerEntry {
  entryId       Int                              @id(map: "ledger_entry_pkey1") @default(autoincrement()) @map("entry_id")
  transactionId Int                              @map("transaction_id")
  accountId     Int                              @map("account_id")
  direction     String
  amount        Decimal(precision: 12, scale: 2)
  account       Account                          @relation(fields: [accountId], references: [accountId], map: "account_id", index: false)
  transaction   Transcation                      @relation(fields: [transactionId], references: [transactionId], onDelete: Cascade, map: "transaction_id", index: false)

  @@map("ledger_entry")
}

model Payment {
  paymentId Int @id(map: "payment_pkey") @map("payment_id")

  @@map("payment")
}
